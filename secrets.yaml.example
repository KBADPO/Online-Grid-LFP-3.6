# ============================================================================
# Шаблон файлу секретів для ESPHome
# Скопіюйте цей файл під назвою secrets.yaml у папку вашого ESPHome
# і підставте власні значення.
# ============================================================================

# Назва та пароль вашої домашньої Wi-Fi мережі (2.4 ГГц)
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Ключ шифрування API для Home Assistant (32 байти у форматі base64).
# Згенерувати новий ключ можна на сайті https://esphome.io/components/api.html
# або просто видалити блок encryption у конфігурації, якщо ключ не потрібен.
api_encryption_key: "YOUR_32_BYTE_BASE64_API_KEY_HERE="

# Bluetooth MAC-адреса вашої плати JK-BMS.
# Можна подивитися в додатку JK-BMS на смартфоні або в логах ESPHome.
bms_mac_address: "C8:47:80:XX:XX:XX"

# 64-бітні адреси датчиків температури DS18B20 (1-Wire).
# Підключіть датчики до GPIO33, запустіть прошивку і скопіюйте знайдені
# адреси з логів ESPHome ("Found sensors:").
dallas_charger_address: 0x0000000000000028
dallas_inverter_address: 0x0000000000000028

