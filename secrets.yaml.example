# ============================================================================
# EN: ESPHome Secrets Template
#     Copy this file to `secrets.yaml` in your ESPHome directory and fill in
#     your own values.
# UA: Шаблон файлу секретів для ESPHome
#     Скопіюйте цей файл під назвою `secrets.yaml` у папку вашого ESPHome
#     і підставте власні значення.
# ============================================================================

# EN: Your 2.4 GHz Wi-Fi network SSID and password
# UA: Назва та пароль вашої домашньої Wi-Fi мережі (2.4 ГГц)
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# EN: Home Assistant Native API encryption key (32-byte base64 string).
#     Generate one at https://esphome.io/components/api.html
# UA: Ключ шифрування API для Home Assistant (32 байти у форматі base64).
#     Згенерувати новий ключ можна на https://esphome.io/components/api.html
api_encryption_key: "YOUR_32_BYTE_BASE64_API_KEY_HERE="

# EN: Bluetooth MAC address of your JK-BMS board.
#     Check it in the JK-BMS smartphone app or in the ESPHome logs.
# UA: Bluetooth MAC-адреса вашої плати JK-BMS.
#     Можна подивитися в додатку JK-BMS на смартфоні або в логах ESPHome.
bms_mac_address: "C8:47:80:XX:XX:XX"

# EN: 64-bit 1-Wire addresses of the two DS18B20 temperature sensors.
#     Connect the sensors to GPIO33, flash the firmware, and copy the discovered
#     addresses from the ESPHome logs ("Found sensors:").
# UA: 64-бітні адреси датчиків температури DS18B20 (1-Wire).
#     Підключіть датчики до GPIO33, запустіть прошивку і скопіюйте знайдені
#     адреси з логів ESPHome ("Found sensors:").
dallas_charger_address: 0x0000000000000028
dallas_inverter_address: 0x0000000000000028
